F 1 "1M" V 1350 800 50  0000 C CNN
F 2 "Resistor_Axial" H 1400 800 50  0001 C CNN
F 3 "" H 1400 800 50  0001 C CNN
	1    1400 800
	1    0    0    -1  
$EndComp

$Comp
L Power:+400V #PWR01
